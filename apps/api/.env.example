# Copy to apps/api/.env for local development.
# The api is the gateway: it serves the web app, verifies tokens and assembles
# portfolios. Sign-in lives in apps/auth, scanning in apps/wallet.

DATABASE_URL="postgresql://svinooh:svinooh@localhost:5432/svinooh"

# Must match JWT_SECRET in apps/auth — that service signs the tokens, this one verifies them
JWT_SECRET="dev-secret-change-me"

# Internal addresses of the other services
AUTH_SERVICE_URL="http://localhost:3001"
WALLET_SERVICE_URL="http://localhost:3002"

# Must match apps/wallet's SYNC_INTERVAL_MIN: it drives the "stale" flag (3× this)
# and is reported to the frontend. Lower than the real cadence and everything
# reads as stale straight after being scanned.
SYNC_INTERVAL_MIN="5"

# Cache of assembled portfolios. Empty — an in-memory cache, no Redis needed locally.
# REDIS_URL="redis://localhost:6379"
CACHE_TTL_SEC="60"

# CORS: the web app origin ("*" — allow everyone; for production a web domain is better)
WEB_ORIGIN="*"

PORT="3000"

# ── Svinooh.Pro billing ──
# Which gateway checkout opens invoices on: nowpayments (default) or cryptomus.
# Both webhook routes stay mounted either way. With neither key set, checkout
# answers 503 and everything else works — payments are simply not configured.
# BILLING_PROVIDER="nowpayments"
# NOWPayments: API key + IPN secret (dashboard → Settings → Payments). Point
# NOWPAYMENTS_API_URL at https://api-sandbox.nowpayments.io/v1 to exercise the
# whole flow with the sandbox's play money (the sandbox has its own key and
# secret; `npm run -w apps/api check:sandbox` does exactly that).
# NOWPAYMENTS_API_KEY=""
# NOWPAYMENTS_IPN_SECRET=""
# NOWPAYMENTS_API_URL="https://api.nowpayments.io/v1"
# Cryptomus — the standing fallback: merchant UUID and Payment API key
# (business account, after domain verification). Sweep funds out on a
# schedule if this is ever switched on.
# CRYPTOMUS_MERCHANT_ID=""
# CRYPTOMUS_API_KEY=""
# Public URL of THIS api — the gateways call the payment webhook on it.
# Empty: no callback is requested (local dev; point the dashboard at a tunnel).
# PUBLIC_API_URL="https://api.svinooh.com"
# Public URL of the site: checkout returns there, billing messages link there
WEB_URL="https://svinooh.com"
# The broker, for the thank-you message after a payment. Empty — not sent.
# RABBITMQ_URL="amqp://svinooh:svinooh@localhost:5672"

# Where to ship logs. Empty — stdout only.
# LOKI_URL="http://localhost:3100"
# Traces. Empty — tracing off.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# Label under which the service appears in metrics, logs and traces
SERVICE_NAME="svinooh-api"
