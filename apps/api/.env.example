# Скопируй в apps/api/.env для локальной разработки

DATABASE_URL="postgresql://svinooh:svinooh@localhost:5432/svinooh"

# Любая длинная случайная строка; в проде обязательно поменять
JWT_SECRET="dev-secret-change-me"

# Telegram Login Widget. Бот создаётся у @BotFather, домен привязывается
# командой /setdomain (для прода — домен web-сервиса на Railway).
# Без этих переменных кнопка входа через Telegram не показывается.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Локальный вход без Telegram (кнопка "dev-вход" на главной). В проде — false!
AUTH_DEV_MODE="true"

# Как часто фоново пересканировать все кошельки
SYNC_INTERVAL_MIN="5"

# CORS: origin web-приложения ("*" — разрешить всем; для прода лучше домен web)
WEB_ORIGIN="*"

PORT="3000"

# EVM: первично HTTP к debank.com (реверс-подпись), фоллбэк на headless Chrome.
# false — всегда идти сразу в Chrome (если HTTP-путь начнёт стабильно падать).
EVM_HTTP_ENABLED="true"
# Конкурентность HTTP-сканов EVM (Chrome-путь всё равно сериализован до 1).
EVM_HTTP_CONCURRENCY="3"
# Прокси для debank.com — на случай бана датацентрового IP (Railway). Пусто — напрямую.
# DEBANK_PROXY_URL="http://user:pass@host:port"

# Необязательное: свой Chrome для puppeteer (в Docker задаётся автоматически)
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
# CHROME_NO_SANDBOX="false"
