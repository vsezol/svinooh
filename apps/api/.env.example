# Copy to apps/api/.env for local development.
# The api is the gateway: it serves the web app, verifies tokens and assembles
# portfolios, and runs the scan pipeline (src/wallet). Sign-in lives in apps/auth.

DATABASE_URL="postgresql://svinooh:svinooh@localhost:5432/svinooh"

# Must match JWT_SECRET in apps/auth — that service signs the tokens, this one verifies them
JWT_SECRET="dev-secret-change-me"

# Internal addresses of the other services
AUTH_SERVICE_URL="http://localhost:3001"

# The scan cadence: it drives the "stale" flag (3× this) and is reported to the
# frontend. It used to have to match the wallet service's copy of the same
# variable — the pipeline is in this process now, so there is one value and
# nothing to keep in step.
SYNC_INTERVAL_MIN="5"

# CORS: the web app origin ("*" — allow everyone; for production a web domain is better)
WEB_ORIGIN="*"

PORT="3000"

# ── Svinooh.Pro billing ──
# NOWPayments carries the checkout: API key + IPN secret (dashboard →
# Settings → Payments). With no key set, checkout answers 503 and everything
# else works — payments are simply not configured. Point NOWPAYMENTS_API_URL
# at https://api-sandbox.nowpayments.io/v1 to exercise the whole flow with
# the sandbox's play money (the sandbox has its own key and secret;
# `npm run -w apps/api check:sandbox` does exactly that).
# NOWPAYMENTS_API_KEY=""
# NOWPAYMENTS_IPN_SECRET=""
# NOWPAYMENTS_API_URL="https://api.nowpayments.io/v1"
# Which coin checkout locks the invoice to; "page" leaves the choice on the
# gateway's page. Normally set from the admin panel (billing.payCoin) — the
# env only carries local development. A coin whose network minimum is above
# the price falls back to "page" by itself.
# BILLING_PAY_COIN="page"
# Public URL of THIS api — the gateways call the payment webhook on it.
# Empty: no callback is requested (local dev; point the dashboard at a tunnel).
# PUBLIC_API_URL="https://api.svinooh.com"
# Public URL of the site: checkout returns there, billing messages link there
WEB_URL="https://svinooh.com"
# The queue (BullMQ on Redis): scan jobs, results and what the bot is told.
# Empty — nothing is scanned and no message is sent.
# REDIS_URL="redis://localhost:6379"

# Where to ship logs. Empty — stdout only.
# LOKI_URL="http://localhost:3100"
# Traces. Empty — tracing off.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# Label under which the service appears in metrics, logs and traces
SERVICE_NAME="svinooh-api"

# --- earn: where a token can be put to work (src/earn) ---------------------
# Upstream. The public Kamino API — no key needed for what the catalog reads.
# EARN_KAMINO_API="https://api.kamino.finance"
# EARN_HTTP_TIMEOUT_S="20"
# EARN_HTTP_CONCURRENCY="8"
# How far behind upstream an answer may be, and when it starts saying so.
# EARN_REFRESH_INTERVAL_S="300"
# EARN_STALE_AFTER_S="900"
# How many past catalogs stay reachable, so a cursor issued against one still
# resolves after a rebuild.
# EARN_CATALOG_HISTORY="3"
# How long startup waits for the first catalog before serving anyway.
# EARN_STARTUP_GRACE_S="45"
# What is worth listing: Kamino's API returns every vault ever created.
# EARN_MIN_TVL_USD="100000"
# EARN_EXCLUDED_NAME_MARKS="test,staging,mock,demo"
# EARN_INCLUDE_RESERVES="1"
# EARN_DEFAULT_PAGE_SIZE="20"
# EARN_MAX_PAGE_SIZE="100"
# SOLANA_RPC_URL above is the node a deposit is built against.
