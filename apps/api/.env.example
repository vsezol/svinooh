# Copy to apps/api/.env for local development

DATABASE_URL="postgresql://svinooh:svinooh@localhost:5432/svinooh"

# Any long random string; be sure to change it in production
JWT_SECRET="dev-secret-change-me"

# Telegram Login Widget. The bot is created via @BotFather, the domain is linked
# with the /setdomain command (for production — the domain of the web service on Railway).
# Without these variables the Telegram login button is not shown.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Local login without Telegram (the "dev login" button on the home page). In production — false!
AUTH_DEV_MODE="true"

# How often to re-scan all wallets in the background
SYNC_INTERVAL_MIN="5"

# CORS: the web app origin ("*" — allow everyone; for production a web domain is better)
WEB_ORIGIN="*"

PORT="3000"

# EVM: primarily HTTP to debank.com (reverse signature), with a fallback to headless Chrome.
# false — always go straight to Chrome (if the HTTP path starts failing consistently).
EVM_HTTP_ENABLED="true"
# Concurrency of EVM HTTP scans (the Chrome path is serialized to 1 anyway).
EVM_HTTP_CONCURRENCY="3"
# Proxy for debank.com — in case the datacenter IP gets banned (Railway). Empty — direct connection.
# DEBANK_PROXY_URL="http://user:pass@host:port"

# Optional: a custom Chrome for puppeteer (set automatically in Docker)
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
# CHROME_NO_SANDBOX="false"
