    "@solana-program/compute-budget": "^0.8.0",
    "@solana-program/token": "^0.6.0",
    "@solana/kit": "^2.3.0",
    "@solana/web3.js": "^1.99.0",
    "@svinooh/common": "*",
    "@svinooh/content": "*",
    "@svinooh/db": "*",
    "@svinooh/shared": "*",
    "bn.js": "^5.2.5",
    "decimal.js": "^10.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/bn.js": "^5.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
