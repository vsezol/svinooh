# Copy to apps/auth/.env for local development.
# The auth service owns sign-in: the Telegram bot, the login widget and issuing
# JWTs. It is not exposed publicly — the api forwards /auth/* to it.

DATABASE_URL="postgresql://svinooh:svinooh@localhost:5432/svinooh"

# Must match JWT_SECRET in apps/api — this service signs the tokens, that one verifies them
JWT_SECRET="dev-secret-change-me"

# Telegram Login Widget. The bot is created via @BotFather, the domain is linked
# with the /setdomain command (for production — the domain of the web service on Railway).
# Without these variables the Telegram login button is not shown.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Local login without Telegram (the "dev login" button on the home page). In production — false!
AUTH_DEV_MODE="true"

# Public URL of the web app — the bot's "open my portfolio" button links here,
# and the domain wallet sign-in asks a wallet to sign against (a wallet shows it
# next to the site it is really talking to, so it must match)
WEB_URL="http://localhost:5173"

PORT="3001"

# Where to ship logs. Empty — stdout only.
# LOKI_URL="http://localhost:3100"
# Traces. Empty — tracing off.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
SERVICE_NAME="svinooh-auth"
