# Copy to apps/scanner-evm/.env for local development.
# scanner-evm takes an address off the scan.evm queue and returns what it holds.
# It has no database and no idea what a portfolio is. It is not exposed publicly.

PORT="3000"

# Scan queue. Empty — no broker: nothing to consume, useful when driving the
# scanner directly from a script.
# RABBITMQ_URL="amqp://svinooh:svinooh@localhost:5672"
# Pacing: the slot is held for this pause after each scan, so the queue doesn't
# hand over the next address until it elapses.
SCAN_JOB_DELAY_MS="1500"

# --- Browser engine -------------------------------------------------------
# Which engine drives the browser scan:
#   lightpanda (default) — a light Zig headless browser, ~2.5-3x less RAM than
#     Chrome on this workload (measured). Run scripts/fetch-lightpanda.sh once to
#     put the binary in apps/scanner-evm/bin; Docker downloads its own copy.
#   chrome — puppeteer-launched Chromium, the fallback that has always worked.
SCANNER_ENGINE="lightpanda"
# Explicit path to the lightpanda binary. Empty => look in apps/scanner-evm/bin,
# then /usr/local/bin/lightpanda, then PATH.
# LIGHTPANDA_PATH=""
# LIGHTPANDA_HOST="127.0.0.1"
# LIGHTPANDA_PORT="9222"

# Chrome fallback (only when SCANNER_ENGINE=chrome). Empty — puppeteer's bundled
# Chromium; in Docker this is set to the system chromium automatically.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
# A container has no user namespaces to sandbox with, so the sandbox is disabled
# there. false for a normal desktop.
CHROME_NO_SANDBOX="false"

# --- EVM scan paths -------------------------------------------------------
# Primary path is a signed HTTP call to debank.com; the browser is the fallback.
# false — always go straight to the browser (if the HTTP path fails consistently).
EVM_HTTP_ENABLED="true"
# Concurrency of EVM HTTP scans (the browser path is serialized to 1 regardless)
EVM_HTTP_CONCURRENCY="3"
HTTP_TIMEOUT_MS="15000"
# A browser scan is slow by nature — page load, chains resolving one by one
EVM_TIMEOUT_MS="150000"
# Proxy for debank.com — in case the datacenter IP gets banned. Empty — direct.
# DEBANK_PROXY_URL="http://user:pass@host:port"

# Where to ship logs / traces. Empty — stdout only, tracing off.
# LOKI_URL="http://localhost:3100"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
SERVICE_NAME="svinooh-scanner-evm"
