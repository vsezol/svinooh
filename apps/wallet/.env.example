# Copy to apps/wallet/.env for local development.
# The wallet service owns scanning: the RabbitMQ queue, the chain scanners and
# the balance snapshots. It is not exposed publicly.

DATABASE_URL="postgresql://svinooh:svinooh@localhost:5432/svinooh"

PORT="3002"

# Scan queue. Empty — no broker: addresses are scanned in-process on a timer,
# so local development doesn't need RabbitMQ running.
# RABBITMQ_URL="amqp://svinooh:svinooh@localhost:5672"
SCAN_QUEUE_NAME="wallet.scan"
# Pacing: a pause after each scan — "gently", to hit 429s less often
SCAN_JOB_DELAY_MS="1500"
# How many addresses to work through at once (1 — gentlest on rate limits)
SCAN_PREFETCH="1"
# How often to check that the queue has drained and re-enqueue wallets
SCAN_RELOAD_SEC="15"
# How often a wallet somebody uses is rescanned — the real pacing knob. Only
# addresses that are DUE get enqueued, so this is the actual cadence.
SYNC_INTERVAL_MIN="5"
# The slow tier: wallets that only exist in anonymous portfolios nobody opened
SYNC_IDLE_INTERVAL_MIN="30"
# How recently a portfolio must have been opened to count as "in use"
SYNC_ACTIVE_WINDOW_MIN="15"
# How many cycles in a row must confirm a sharp drop before we believe it
SYNC_DROP_CONFIRM_CYCLES="3"

# EVM: primarily HTTP to debank.com (reverse signature), with a fallback to headless Chrome.
# false — always go straight to Chrome (if the HTTP path starts failing consistently).
EVM_HTTP_ENABLED="true"
# Concurrency of EVM HTTP scans (the Chrome path is serialized to 1 anyway)
EVM_HTTP_CONCURRENCY="3"
# Concurrency of the BTC/SOL/TRON HTTP scanners
SCAN_HTTP_CONCURRENCY="4"
# Proxy for debank.com — in case the datacenter IP gets banned (Railway). Empty — direct connection.
# DEBANK_PROXY_URL="http://user:pass@host:port"

# Optional: a custom Chrome for puppeteer (set automatically in Docker)
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
# CHROME_NO_SANDBOX="false"

# Where to ship logs. Empty — stdout only.
# LOKI_URL="http://localhost:3100"
# Traces. Empty — tracing off.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
SERVICE_NAME="svinooh-wallet"
