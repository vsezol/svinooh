# Upstream. The public Kamino API — no key needed for what the catalog reads.
EARN_KAMINO_API=https://api.kamino.finance
EARN_HTTP_TIMEOUT_S=20
EARN_HTTP_CONCURRENCY=8

# How far behind upstream an answer may be, and when it starts saying so.
EARN_REFRESH_INTERVAL_S=300
EARN_STALE_AFTER_S=900
# How many past catalogs stay reachable, so a cursor issued against one still
# resolves after a rebuild.
EARN_CATALOG_HISTORY=3
# How long startup waits for the first catalog before serving anyway. Ready on
# the first healthcheck probe when upstream is healthy; never blocked by one
# that is not.
EARN_STARTUP_GRACE_S=45

# What is worth listing. Kamino's API returns every vault ever created; its own
# UI hides the unfunded ones behind a threshold it does not expose, so this is
# our approximation of the same judgement.
EARN_MIN_TVL_USD=100000
EARN_EXCLUDED_NAME_MARKS=test,staging,mock,demo
# Direct supply into Kamino Lend reserves, beside the curated vaults.
EARN_INCLUDE_RESERVES=1

# The node. Building a deposit reads accounts from the chain, and this is the
# only service that talks to one — a key here is a key the browser never sees.
# The public endpoint is rate-limited and fine for local work.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Serving.
EARN_DEFAULT_PAGE_SIZE=20
EARN_MAX_PAGE_SIZE=100
# Empty means no browser may call this directly — right while the only caller
# is the agent service over the private network.
EARN_CORS_ORIGINS=
