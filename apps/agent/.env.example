# Set these on the Railway service — I don't enter secrets.
#
# ── the models, one per job ─────────────────────────────────────────────────
# Each job the service gives a model is a role with its own dials, because the
# jobs want different things: the one that answers is read by a person and can
# afford to think; the one that labels picks a word out of two in front of
# every answer and must not keep anyone waiting.
#
#   AGENT_<ROLE>_MODEL             which model does this job
#   AGENT_<ROLE>_REASONING_EFFORT  how much it may think first
#                                  (none/minimal/low/medium/high, or empty)
#   AGENT_<ROLE>_MAX_TOKENS        how much it may write
#
# A role with nothing set runs on the answering model, so a new one works
# before anybody configures it. Adding a role (a critic, a summariser) is a
# line in app/config.py plus its variables here.
#
# ROLE is empty for answering and ROUTER_ for labelling:
# AGENT_MODEL=openai:deepseek/deepseek-v4-flash
# AGENT_REASONING_EFFORT=minimal
# AGENT_MAX_TOKENS=1024
# AGENT_ROUTER_MODEL=          # empty: the answering model labels too. A cheaper
#   one is worth trying, but check its providers can serve us first -- see the
#   note on the knob in the admin panel.
# AGENT_ROUTER_REASONING_EFFORT=       # empty on purpose, and the only safe
#   value to leave here. A thinking setting is a demand: "none" is refused by a
#   model that must think, and any positive value is refused by a model that
#   cannot — a provider has to support every parameter we send, so asking an
#   instruct model to think filters every provider away. Empty asks for
#   nothing. Both refusals took the classifier down in production.
# AGENT_ROUTER_MAX_TOKENS=200
#
# The account is shared by every role — it is about who we call through, not
# about the job. Both names are ours, so switching vendor never means learning
# what that vendor calls its key.
AGENT_MODEL_API_KEY=
# AGENT_MODEL_BASE_URL=https://openrouter.ai/api/v1

# Which of an aggregator's providers may serve any of it. One model id is
# served by several, and they differ in speed, quantisation, what they really
# support, and what they do with the prompt afterwards.
# AGENT_PROVIDER_DATA_COLLECTION=deny   # ours carry wallet addresses
# AGENT_PROVIDER_REQUIRE_PARAMETERS=1   # tools are not optional here
# AGENT_PROVIDER_SORT=throughput

# ── everything else ─────────────────────────────────────────────────────────
# AGENT_TOOL_HOPS=3                   # max tool rounds per grounded turn
# AGENT_CORS_ORIGINS=https://svinooh.com   # browser origins allowed in, comma-separated
# AGENT_AUTH_CACHE_TTL_S=60           # how long a positive token check stands
# AGENT_RATE_LIMIT_REQUESTS=20        # chat turns per caller per window
# AGENT_RATE_LIMIT_WINDOW_S=300       # the window, seconds
# AGENT_SYSTEM="..."                  # override the system prompt (English)

# AGENT_MAX_TOKENS=1024
# AGENT_TIMEOUT_S=60
# AGENT_HISTORY_MAX_MESSAGES=40      # per-session conversation cap
# AGENT_HISTORY_TTL_S=1800           # idle sessions are forgotten after this

# The portfolio public API (DataSource #1) — on Railway, the api service's
# private domain. The agent calls it with the caller's own token.
# PORTFOLIO_API_URL=http://localhost:3000
# AGENT_CONTEXT_TIMEOUT_S=10         # slow context -> answer without it
PORT=3000
