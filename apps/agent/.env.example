# Set these on the Railway service — I don't enter secrets.
# The key matches the provider in AGENT_MODEL and is read from the environment
# by the provider plugin; never hardcode it. Anthropic -> ANTHROPIC_API_KEY,
# Gemini -> GOOGLE_API_KEY, and so on.
ANTHROPIC_API_KEY=sk-ant-...

# "<provider>:<model>" — the whole provider choice is this one string.
# Haiku while we iterate (fast, cheap); a stronger model or another provider
# is a config change, not a code change (see app/llm.py).
# AGENT_MODEL=anthropic:claude-haiku-4-5
# AGENT_SYSTEM="..."                  # override the system prompt (English)
# AGENT_MAX_TOKENS=1024
# AGENT_TIMEOUT_S=60
# AGENT_HISTORY_MAX_MESSAGES=40      # per-session conversation cap
# AGENT_HISTORY_TTL_S=1800           # idle sessions are forgotten after this
PORT=3000
