# Set these on the Railway service — I don't enter secrets.
# The key is read from the environment by ChatAnthropic; never hardcode it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional:
# AGENT_MODEL=claude-opus-5     # cheap/fast for experiments -> claude-haiku-4-5
# AGENT_SYSTEM="..."            # override the system prompt
PORT=3000
