# Set these on the Railway service — I don't enter secrets.
#
# ── the models ──────────────────────────────────────────────────────────────
# Two models do two jobs:
#   AGENT_MODEL         answers      — the one the user reads
#   AGENT_ROUTER_MODEL  labels       — the intent and confirmation classifiers.
#                                      A dozen output tokens each, so this is
#                                      where a cheaper tier pays off.
#                                      Empty: the answering model labels too.
# Both are "<provider>:<model>"; the provider prefix decides which wire is
# spoken, so switching vendor is a value here plus that provider's package in
# requirements.txt — never a code change (see app/llm.py).
#
# Credentials are named for this service, not for whichever vendor is behind it
# today — one pair of names covers every provider, and both models share them:
#   AGENT_MODEL_API_KEY   the key
#   AGENT_MODEL_BASE_URL  the endpoint, when it is not the provider's own
# Leave the key empty and the provider plugin falls back to its own variable
# (ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_API_KEY...).

# Direct to a provider:
# AGENT_MODEL=anthropic:claude-haiku-4-5
AGENT_MODEL_API_KEY=

# Through OpenRouter — one key, any vendor's model, picked by slug. The wire is
# OpenAI-compatible, hence the openai: prefix whoever actually serves it.
# AGENT_MODEL=openai:google/gemini-2.5-flash
# AGENT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# AGENT_ROUTER_MODEL=openai:openai/gpt-oss-120b  # cheaper tier for the classifiers

# ── everything else ─────────────────────────────────────────────────────────
# AGENT_TOOL_HOPS=3                   # max tool rounds per grounded turn
# AGENT_CORS_ORIGINS=https://svinooh.com   # browser origins allowed in, comma-separated
# AGENT_AUTH_CACHE_TTL_S=60           # how long a positive token check stands
# AGENT_RATE_LIMIT_REQUESTS=20        # chat turns per caller per window
# AGENT_RATE_LIMIT_WINDOW_S=300       # the window, seconds
# AGENT_SYSTEM="..."                  # override the system prompt (English)

# AGENT_MAX_TOKENS=1024
# AGENT_TIMEOUT_S=60
# AGENT_HISTORY_MAX_MESSAGES=40      # per-session conversation cap
# AGENT_HISTORY_TTL_S=1800           # idle sessions are forgotten after this

# The portfolio public API (DataSource #1) — on Railway, the api service's
# private domain. The agent calls it with the caller's own token.
# PORTFOLIO_API_URL=http://localhost:3000
# AGENT_CONTEXT_TIMEOUT_S=10         # slow context -> answer without it
PORT=3000
