generator client {
  provider      = "prisma-client-js"
  // native — for local development (macOS); debian-openssl-3.0.x — the runtime
  // of the Docker image on Railway (node:22-slim = Debian bookworm, OpenSSL 3.0)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String           @id @default(cuid())
  telegramId BigInt?          @unique
  /// X (Twitter) account id — a separate identity, exactly as telegramId is:
  /// signing in with X makes its own user, never links to a Telegram one
  xId        String?          @unique
  /// The wallet address that signed in — a third identity, and as separate from
  /// the other two. Stored exactly as the chain spells it: base58 is
  /// case-sensitive, so lower-casing a Solana address would make it a different
  /// address (see normalizeAddress, which this follows).
  walletAddress String?       @unique
  /// Telegram chat that receives this user's alerts when the identity itself
  /// is not Telegram. A delivery address, not an identity: the chat's own
  /// Telegram account, if it ever signs in, is a different user entirely.
  alertChatId BigInt?
  // Identifier for dev login (AUTH_DEV_MODE=true), not used in production
  devKey     String?          @unique
  firstName  String?
  lastName   String?
  username   String?
  photoUrl   String?
  /// May read and change the system's tunables. Set in the database and nowhere
  /// else: there is no way to grant it from the product, which is the point.
  isAdmin    Boolean          @default(false)
  createdAt  DateTime         @default(now())
  owned      PortfolioOwner[]
  loginLinks LoginLink[]
  subscription Subscription?
  payments     Payment[]
  featureUsage FeatureUsage?
}

/// Svinooh.Pro, as the one fact billing actually needs: until when it is paid.
///
/// No status column — whether somebody is Pro is `paidUntil > now`, and a
/// stored status would be a second copy of that answer, wrong for the minute
/// nobody updated it. A user with no row at all is simply on the free plan,
/// the same way a wallet with no WalletAlerts row is on the defaults.
///
/// Crypto has no dependable auto-debit (nothing can pull money out of a
/// wallet), so a "subscription" here is prepaid time: every finished payment
/// moves paidUntil forward, and the reminders below are what stands in for a
/// charge on file.
model Subscription {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidUntil DateTime
  /// When we last said "this is about to end". Compared against paidUntil
  /// rather than cleared on renewal: a reminder is due when none has been sent
  /// since this paid period entered its final days, so paying re-arms it with
  /// no second write to get wrong — the same shape as slowedNoticeAt.
  remindedAt DateTime?
  /// When we said "it has ended", for the same reason: once per expiry, and a
  /// renewal moving paidUntil forward is what re-arms it.
  expiredNoticeAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paidUntil])
}

/// One attempt to pay for Pro, from the moment a checkout is opened.
///
/// The row is created BEFORE the gateway is asked for an invoice, so a webhook
/// about an order we cannot find is loud evidence of a bug (or of somebody
/// else's environment) rather than silent money. `orderId` is ours and unique
/// — it is what the gateway echoes back, and matching on it is what makes the
/// webhook unable to pay for the wrong account.
///
/// Rows are never deleted and `paid` is never left: a webhook can arrive
/// twice, out of order, or after a refund, and the answer to "did this pay for
/// a month" has to stay put once given — the subscription was extended on the
/// strength of it.
model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Which gateway carried it: 'nowpayments'. Beside the money rather than in
  /// config, because a provider switch must not orphan the history.
  provider String
  /// Our id for the order, handed to the gateway and echoed back by its webhook
  orderId String @unique
  /// The client's name for one attempt to pay, from the Idempotency-Key
  /// header. Asked again under the same key while its invoice can still be
  /// paid, checkout answers with that invoice instead of opening a second one.
  /// Unique per user rather than globally: a key is only ever looked up inside
  /// the account that sent it, so nobody reaches another person's invoice by
  /// guessing one, nor hands them theirs to pay.
  idempotencyKey String?
  /// The gateway's own ids, once it has answered: the invoice a person was
  /// sent to, and the payment they made against it.
  invoiceId         String?
  providerPaymentId String?
  /// What was bought: months of Pro, at this price. The price is copied here
  /// from the tunables at checkout time — the knob can move next week and this
  /// row still has to say what THIS person was asked to pay.
  months   Int   @default(1)
  priceUsd Float
  /// created → waiting → confirming → paid, or off the rails into underpaid /
  /// failed / expired / refunded. Written only by the webhook after creation.
  status String @default("created")
  /// What the payer actually chose and sent, as the gateway reported it —
  /// for reading a dispute a month later without the gateway's dashboard.
  payCurrency String?
  paidAmount  Float?
  invoiceUrl  String?
  /// The raw webhook body that decided the current status, for the same reason
  raw Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

/// How much of the metered features one user has consumed. One row per user,
/// upserted by whoever hands the feature out; no row is a user who has spent
/// nothing.
///
/// `alertsSent` is lifetime, because the trial is "the first N alerts ever",
/// not N per month — deleting and re-adding wallets must not refill it. The AI
/// pair is a day's count and the day it belongs to, overwritten in place when
/// the date rolls: a row per day would be a cleanup job for data nothing reads
/// after midnight.
model FeatureUsage {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Alert messages actually delivered to this user's chat, ever
  alertsSent Int @default(0)
  /// When we last answered a would-be alert with the upgrade pitch instead —
  /// the throttle that keeps a busy wallet from turning marketing into spam
  alertsUpsellAt DateTime?
  /// The day aiUsed counts, as 'YYYY-MM-DD' in UTC; a row from yesterday reads
  /// as zero used today
  aiDay  String?
  aiUsed Int     @default(0)
  updatedAt DateTime @updatedAt
}

/// A sign-in link the bot puts in the chat. Opening it signs the visitor in as
/// this user, on whatever device opened it — which is the point: Telegram opens
/// links in its own browser, on a phone that may not be the machine the sign-in
/// started on, and a session that only exists in the tab that began it is a
/// session most people never reach.
///
/// It is a bearer credential, so it is short-lived, counted, and superseded:
/// issuing a new one drops the user's older links, which means the newest
/// message in the chat is always the only live link.
/// A sign-in the site started and is still waiting on.
///
/// The site opens t.me/<bot>?start=<token>; the bot answers that it was the
/// person holding the phone. The tab polls until it is, then trades the row for
/// a session. Five minutes, one use.
///
/// In a table rather than in memory because the bot and the gateway are
/// separate services now: only one process may long-poll a bot token, so the
/// one that hears the answer is not the one the tab is asking.
model TelegramLogin {
  token      String   @id
  /// Set when the bot confirms who pressed Start; null while still waiting
  telegramId BigInt?
  /// Set when this token CONNECTS a chat to an existing user (alert delivery)
  /// instead of signing somebody in. Login polls skip these rows entirely.
  connectUserId String?
  firstName  String?
  lastName   String?
  username   String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

/// A wallet sign-in the site started and is still waiting on: the message we
/// asked an address to sign, kept until the signature comes back.
///
/// The whole message is stored rather than re-derived, so verification never
/// has to trust — or parse — anything the browser sends back. It signs what we
/// wrote or it signs nothing; the row is the only thing the signature is
/// checked against, and it is deleted the moment it is spent, which is what
/// makes a captured signature worthless the second time.
///
/// In a table for the same reason TelegramLogin is: any instance must be able
/// to finish a sign-in another one started.
model WalletLogin {
  nonce     String   @id
  /// The address the message names, spelled as its chain spells it. The signer
  /// must be this one, so a signature from another wallet cannot redeem it.
  address   String
  /// The exact text handed to the wallet
  message   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model LoginLink {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  // Bounded rather than one-shot: this exact flow opens the same link two or
  // three times (Telegram's browser, then "open in Safari", then a reload)
  uses      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A portfolio is a standalone thing: a group of wallets behind a slug. It holds
/// no reference to a user — who owns it, and whether it may be listed, live in
/// PortfolioOwner. Without an owner row it is an anonymous portfolio: it belongs
/// to nobody, is public by nature and carries no user data at all.
model Portfolio {
  id           String              @id @default(cuid())
  slug         String              @unique
  // Optional, and empty by default: the slug is what identifies a portfolio.
  // An auto-generated name would either say nothing ("My portfolio", first
  // person, shown to strangers) or name a wallet, which defeats the point of
  // grouping several of them.
  name         String?
  wallets      PortfolioWallet[]
  owner        PortfolioOwner?
  createdAt    DateTime            @default(now())
  // When someone last opened this portfolio. The scan pipeline uses it to
  // decide how often to rescan: what nobody looks at does not need to be fresh.
  lastViewedAt DateTime?
}

/// Ownership of a portfolio, and its visibility. Visibility is a property of the
/// ownership rather than of the portfolio, because a portfolio nobody owns has
/// no one to be private from. `isPublic` defaults to false: what a person
/// creates from their account is private until they say otherwise.
model PortfolioOwner {
  portfolioId String    @id
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  /// The owner's "hide small balances" switch — balances that round to $0 are
  /// dropped from their view. A property of the ownership, like visibility:
  /// how one person prefers to read a portfolio is not the portfolio's own
  /// fact, and a guest viewing the same link starts from the default.
  hideSmallBalances Boolean @default(false)

  /// When we last told this owner their portfolio had gone quiet and its
  /// wallets were being checked less often.
  ///
  /// Compared against lastViewedAt rather than cleared on a visit: a notice is
  /// due when we have not sent one SINCE the last time they looked. That makes
  /// coming back the thing that re-arms it, with no second write to get wrong,
  /// and it is what stops a portfolio nobody ever opens from being announced
  /// every fifteen minutes for the rest of its life.
  slowedNoticeAt DateTime?

  @@index([userId])
}

/// An address we scan, and everything the last scan found on it.
///
/// One row per (chain, address) for the whole system, not one per portfolio
/// that happens to hold it. Which portfolios hold it is PortfolioWallet's
/// business; what the address is worth is this table's, and it is the same
/// answer whoever is asking.
///
/// It used to be both at once, and every reader paid for it: the producer
/// grouped rows by (chain, address) and merged four fields by four different
/// rules to decide when to scan, the writer looped over the group writing
/// identical positions once per portfolio, and the claim was an updateMany
/// across rows that were all the same address anyway.
model Wallet {
  id              String            @id @default(cuid())
  address         String
  chain           String // BTC | EVM | SOL | TRON
  status          String            @default("pending") // pending | ok | failed
  /// Cache of the last SUCCESSFUL scan: not overwritten on error, so we can
  /// serve the stale value with an explicit stale flag instead of losing it
  lastTotalUsd    Float?
  lastSyncedAt    DateTime?
  /// When this address is next worth scanning. The only answer to "should I
  /// scan this now?", and the only thing the producer looks at.
  ///
  /// It used to take five: lastSyncedAt to say when we last managed it,
  /// scanQueuedAt with a TTL to say a scan was already on its way, status
  /// 'pending' plus a sweep to notice one that never came back, and a
  /// queue-depth gate to stop the producer republishing everything. They
  /// overlapped, and the gaps between them were where addresses got stuck.
  ///
  /// Everything that knows something about the timing writes it here instead:
  ///   dispatch  → now + SCAN_LEASE_MIN   (so it is not queued twice)
  ///   result    → now + the interval schedule() picked
  ///   failure   → now + SCAN_RETRY_MIN   (so a broken source is not hammered)
  ///   a visit   → pulled EARLIER, never later, so somebody coming back to a
  ///               portfolio does not wait out a slow interval to see it move
  nextScanAt      DateTime          @default(now())
  lastError       String?
  /// How many scans in a row have said something we would not store.
  ///
  /// A move of more than a quarter in EITHER direction has to be corroborated
  /// by a second reading that agrees with the first, because sources return
  /// partial data — TronGrid without staking, a page that rendered before its
  /// chains resolved — and on a chart that looks like a cliff that heals itself
  /// an hour later. Until two readings agree, this counts the arguing.
  ///
  /// It counted falls alone until 2026-09-08, because rises were not doubted at
  /// all — which let three other people's balances be written onto a $7
  /// address, each accepted for pointing upwards, and then defended by the fall
  /// side of this very counter.
  ///
  /// The COLUMN is still called lowReadings, and that is deliberate. Migrations
  /// run in the api container at boot while the previous image is still up and
  /// serving, so renaming it would break every query that image makes for the
  /// length of a rollout. The field is what the code reads, so the field is
  /// what was corrected.
  ///
  /// Here rather than in the writer's memory, where it used to live. In memory
  /// it pinned that consumer to one process forever, and every redeploy silently
  /// reset the count for every address — so a real move could be argued about
  /// from scratch each time we shipped.
  unbelievedReadings Int            @default(0) @map("lowReadings")
  breakdown       Json?
  unpriced        Json?
  /// TRON only: the wallet's energy, bandwidth and outgoing delegations, as the
  /// last resource read found them (a TronResources). Kept as one JSON value
  /// beside breakdown/unpriced rather than spread over ten columns, because
  /// nothing queries by it — it is rendered and it is compared against itself.
  tronResources   Json?
  /// When that read happened. Resources cost four or more sequential
  /// rate-limited TronGrid calls, so they are refreshed on their own slower
  /// clock (TRON_RESOURCE_INTERVAL_MIN) instead of on every sync, and this is
  /// what says whether the next scan owes one.
  tronResourcesAt DateTime?
  createdAt       DateTime          @default(now())
  positions       Position[]
  memberships     PortfolioWallet[]

  @@unique([chain, address])
  @@index([nextScanAt])
}

/// An address in a portfolio: the membership, and everything that belongs to
/// the person holding it rather than to the address.
///
/// A label is the owner's own words for a wallet and two owners of the same
/// address will not agree on it. Nor on what they want to be told about it —
/// which is why the alert settings and the alert memory hang off this row and
/// not off the address.
model PortfolioWallet {
  id          String             @id @default(cuid())
  portfolioId String
  portfolio   Portfolio          @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  walletId    String
  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  /// User-defined name (the owner sets it inline). null — show the default per network
  label       String?
  createdAt   DateTime           @default(now())
  alerts      WalletAlerts?
  alertStates WalletAlertState[]

  @@unique([portfolioId, walletId])
  @@index([walletId])
}

/// What was last true of a position, so the next scan can tell what changed.
///
/// Keyed by the position key the scan announces rather than by a `Position`
/// row: those are deleted and rewritten every scan, so their ids would say
/// everything had closed and reopened. A row here is a memory, not a holding —
/// a position that goes away leaves its row behind until the wallet does, which
/// costs a few bytes and avoids ever re-announcing a change on the way back.
/// One tunable, as the admin last set it.
///
/// Only the keys somebody has actually changed have rows: everything else falls
/// through to the environment and then to the default declared in
/// libs/settings/registry.json. So an empty table is a system running exactly as
/// it shipped, and the table reads as a list of decisions rather than as a
/// second copy of the defaults.
model Setting {
  key       String   @id
  /// Json rather than String: the registry already says what type a key is, and
  /// storing 5 as "5" means every reader has to agree on how to parse it back
  value     Json
  /// Who changed it, for when a number turns out to have been a mistake
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model WalletAlertState {
  portfolioWalletId String
  portfolioWallet   PortfolioWallet @relation(fields: [portfolioWalletId], references: [id], onDelete: Cascade)
  positionKey       String
  /// null — this position has no band, or nobody could say
  inRange           Boolean?
  /// Whether the health factor was under the owner's threshold last time
  healthBreached    Boolean         @default(false)
  /// Whether the borrow rate was over it
  borrowBreached    Boolean         @default(false)
  /// TRON actions, which are states rather than crossings: whether the wallet
  /// could reclaim, and whether it could delegate, last time we looked. Only
  /// the row under the synthetic TRON key uses these — see tronStateKey.
  reclaimArmed      Boolean         @default(false)
  delegateArmed     Boolean         @default(false)
  updatedAt         DateTime        @updatedAt

  @@id([portfolioWalletId, positionKey])
  @@index([portfolioWalletId])
}

/// What this wallet is watched for, and told about over Telegram.
///
/// One row per wallet, written only by its owner. A wallet nobody has
/// configured has no row at all and is answered with the defaults, so the
/// absence of a row is a wallet on the defaults rather than a wallet nobody
/// can be told about.
///
/// A threshold is null when nobody is watching it. That is a different thing
/// from zero, which would be a threshold that can never be crossed.
model WalletAlerts {
  portfolioWalletId  String          @id
  portfolioWallet    PortfolioWallet @relation(fields: [portfolioWalletId], references: [id], onDelete: Cascade)
  /// An LP position leaving its liquidity range, or coming back into it
  rangeAlerts        Boolean         @default(true)
  /// Told when the health factor falls below this
  healthFactorBelow  Float?
  /// Told when the borrow rate climbs above this, in percent
  borrowApyAbove     Float?
  /// TRON: a delegation came unlocked and there is bandwidth to take it back
  tronReclaimAlerts  Boolean         @default(true)
  /// TRON: resources are free and nothing is delegated
  tronDelegateAlerts Boolean         @default(true)
  updatedAt          DateTime        @updatedAt
}

model Position {
  id            String  @id @default(cuid())
  walletId      String
  wallet        Wallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  // Protocol or ticker: "Pendle V2", "USDT"
  symbol        String
  // Position kind: "Lending", "Liquidity Pool", "Deposit"
  name          String?
  // Extra detail: pool/market name, the protocol's own description
  note          String?
  ref           String?
  pool          String?
  /// The network this position sits on, as the source names it: eth, arb, base,
  /// op, sol, tron, btc. Distinct from Wallet.chain, which is the family — one
  /// EVM wallet holds positions on a dozen networks and "EVM" cannot say which.
  network       String?
  amount        Float?
  priceUsd      Float?
  valueUsd      Float
  platform      String?
  category      String  @default("token") // token | defi | staked | unpriced
  // Yield as a fraction (0.42 = 42% APY), when the source reports one
  apy           Float?
  // Health factor of a lending position (below 1 — liquidation)
  healthRate    Float?
  // What the debt on this position costs, as a positive fraction (0.06 = 6% APY)
  borrowApy     Float?
  // Concentrated liquidity only: "in" | "out" of the position's price range
  range         String?
  /// The band that `range` is a verdict on — a PositionBand: lower, upper and
  /// current price, the pair and which way round the prices read. One JSON
  /// value rather than five columns, because nothing queries by it: it is drawn
  /// and it is compared against itself.
  band          Json?
  // The underlying legs — PositionTokenDto[]: what's supplied, accrued, borrowed
  tokens        Json?
  feesEarnedUsd Float?
}

/// The history of what an address is worth — total, what could be collected, and
/// what is owed — keyed by (chain, address) rather than by a Wallet row.
///
/// A Wallet is scoped to one portfolio (@@unique([portfolioId, address])), so the
/// same address added to a second portfolio is a different row with a different
/// id. Keying history off that row meant reusing a wallet — or removing it from
/// one portfolio and adding it to another — started its history over from empty.
/// Keyed here by the address itself, the history is one thing every portfolio
/// holding that address shares, and it outlives any single Wallet row.
///
/// It carries no portfolio, no owner and no label. What an address is worth is a
/// fact about a public address, identical in every portfolio that holds it, so
/// sharing it across them leaks nothing about anyone — see the privacy rule.
/// Written once per scan (not once per Wallet row that happens to hold it).
model AddressSnapshot {
  id           String   @id @default(cuid())
  chain        String
  address      String
  totalUsd     Float
  // What could have been collected and what was owed at this reading — read off
  // the position legs. Nullable for rows written before they were recorded.
  claimableUsd Float?
  debtUsd      Float?
  breakdown    Json?
  createdAt    DateTime @default(now())

  @@index([chain, address, createdAt])
}

model PositionSnapshot {
  id        String   @id @default(cuid())
  chain     String
  address   String
  key       String
  valueUsd  Float
  amount    Float?
  priceUsd  Float?
  tokens    Json?
  band      Json?
  createdAt DateTime @default(now())

  @@index([chain, address, key, createdAt])
}

/// One movement of value, as one address saw it.
///
/// NOT a deposit or a withdrawal — those are verdicts, and a verdict needs a
/// perimeter to be relative to. The same transfer is an internal move in a
/// portfolio holding both ends of it and an external flow in one that holds
/// only this side, so what it MEANS is decided at read time, per portfolio,
/// in the api's portfolio/transfers.ts. What is stored here is only what happened.
///
/// Keyed by (chain, address) like AddressSnapshot: the same answer whoever is
/// asking, and it outlives any Wallet row. No portfolio, no owner, no label.
/// Only plain transfers — transactions that did nothing but move the money —
/// and only legs that could be priced. See portfolio/transfer-sources.ts.
model AddressTransfer {
  id           String   @id @default(cuid())
  chain        String
  address      String
  txHash       String
  /// Which leg of the transaction, as the source can name it again on a re-read
  leg          String
  minedAt      DateTime
  /// in | out, relative to `address`
  direction    String
  /// The other side; null where there is no single one
  counterparty String?
  /// eth, arb, base, sol, tron, btc — see Position.network
  network      String?
  symbol       String
  amount       Float
  /// Worth at minedAt, not now
  usd          Float
  createdAt    DateTime @default(now())

  @@unique([chain, address, txHash, leg])
  @@index([chain, address, minedAt])
}

/// How far the transfer history of one address has been read.
///
/// History is wanted from `since` — when the address entered the system — and
/// nothing before it. A pass reads newest-first down to a floor: `since` the
/// first time, a little under `syncedTo` after that. Until a pass finishes,
/// `passCursor` is where to resume it, so a long history is read over several
/// runs instead of from the top every time.
model AddressTransferCursor {
  chain         String
  address       String
  since         DateTime
  /// History is complete from `since` up to here. Null — the first pass is not done.
  syncedTo      DateTime?
  /// The pass in progress: the source's cursor, the floor it reads down to,
  /// and when it started (what syncedTo becomes when it finishes)
  passCursor    String?
  passFloor     DateTime?
  passStartedAt DateTime?
  lastError     String?
  /// When the background may try again after an error
  retryAt       DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@id([chain, address])
}
